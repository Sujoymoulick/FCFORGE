---
---

<section
  id="chapter-arrival"
  class="relative min-h-[calc(100dvh-5rem)] flex flex-col justify-between px-4 sm:px-8 pt-4 sm:pt-6 pb-6 overflow-hidden select-none pointer-events-none"
  aria-label="FCForge Arena Hero"
>
  <!-- Warm Ambient Depth Gradients -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-gradient-radial from-[var(--fc-gold)]/10 via-transparent to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-gradient-radial from-[var(--fc-primary)]/5 via-transparent to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- Top Hero Header Bar / Eyebrow (DESIGN.md) -->
  <div class="max-w-7xl mx-auto w-full flex items-center justify-between relative z-20 pointer-events-auto">
    <!-- Chapter Eyebrow Tag -->
    <div class="hero-stagger-1 inline-flex items-center gap-2 px-3 py-1 rounded-[4px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
      <span class="text-[11px] font-mono font-medium tracking-tight text-[var(--fc-primary)] uppercase">
        ARENA ARRIVAL // S4
      </span>
      <span class="text-[var(--fc-mute)] text-[10px]">·</span>
      <span class="text-[10px] font-mono text-[var(--fc-body)]">SEASON PASS ACTIVE</span>
    </div>

    <!-- Supported Platforms Ticker (DM Mono) -->
    <div class="hero-stagger-1 hidden sm:flex items-center gap-3 text-[11px] font-mono tracking-tight text-[var(--fc-body)] bg-[var(--fc-canvas-soft)] px-3 py-1 rounded-[4px] border border-[var(--fc-hairline)]">
      <span class="text-[var(--fc-primary)] font-medium">eFootball™ Mobile</span>
      <span class="text-[var(--fc-mute)]">/</span>
      <span class="text-[var(--fc-primary)] font-medium">EA SPORTS FC™ Mobile</span>
    </div>
  </div>

  <!-- Main Hero Spatial Composition -->
  <div class="max-w-7xl mx-auto w-full my-auto relative z-20 py-6 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Left Column: Typography & Match Workstation (7 cols desktop) -->
    <div class="lg:col-span-7 space-y-6 text-left pointer-events-auto max-w-2xl">
      
      <!-- Main Headline Block (Inter 64px display-xl + Instrument Serif moment) -->
      <div class="space-y-3">
        <div class="hero-stagger-1 inline-block">
          <span class="text-xs font-mono font-medium tracking-wider text-[var(--fc-gold)] uppercase bg-[var(--fc-canvas-soft)] px-2.5 py-0.5 rounded-[3px] border border-[var(--fc-hairline)]">
            THE COMPETITIVE METAGAME
          </span>
        </div>
        
        <h1 class="hero-stagger-2 text-fluid-hero font-display font-normal text-[#f7f5f0] leading-[1.0] select-text">
          FCForge is the <br />
          <span class="font-serif-italic font-normal text-[var(--fc-gold)] text-fluid-section-italic tracking-[-0.01em]">
            football esports arena
          </span> <br />
          built for mobile pros.
        </h1>
      </div>

      <!-- Supporting Body Copy (Inter 16px body-md, max ~65ch) -->
      <p class="hero-stagger-3 text-sm sm:text-base text-[var(--fc-body)] max-w-lg leading-relaxed font-normal select-text">
        Compete in global eFootball and FIFA mobile brackets. Climb division ladders, verify your tactical ratings, and battle for real prize pools.
      </p>

      <!-- Tight Geometry Buttons (DESIGN.md button-primary & button-secondary-ghost) -->
      <div class="hero-stagger-4 flex flex-wrap items-center gap-3 pt-2">
        <a href="/tournaments" class="btn-warp-primary group">
          <span>Explore tournaments</span>
          <span class="font-mono text-xs group-hover:translate-x-0.5 transition-transform">→</span>
        </a>

        <a href="/leaderboards" class="btn-warp-secondary group">
          <span>View global ranking</span>
          <span class="font-mono text-xs text-[var(--fc-mute)] group-hover:text-white transition-colors">↗</span>
        </a>
      </div>

      <!-- Live Performance Specs Tile (DESIGN.md card-mockup / ex-data-table-cell) -->
      <div class="hero-stagger-5 pt-2 max-w-xl">
        <div class="p-3 sm:p-4 rounded-[6px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 text-left">
          <div>
            <span class="block font-display font-medium text-lg sm:text-xl text-[#f7f5f0] tracking-tight">$50K</span>
            <span class="text-[10px] font-mono text-[var(--fc-mute)] uppercase tracking-tight block mt-0.5">MONTHLY POOLS</span>
          </div>
          <div class="sm:border-l border-[var(--fc-hairline)] sm:pl-3">
            <span class="block font-display font-medium text-lg sm:text-xl text-[var(--fc-gold)] tracking-tight">12.5K+</span>
            <span class="text-[10px] font-mono text-[var(--fc-mute)] uppercase tracking-tight block mt-0.5">ATHLETES</span>
          </div>
          <div class="border-t sm:border-t-0 sm:border-l border-[var(--fc-hairline)] pt-2 sm:pt-0 sm:pl-3">
            <span class="block font-display font-medium text-lg sm:text-xl text-[#f7f5f0] tracking-tight">100%</span>
            <span class="text-[10px] font-mono text-[var(--fc-mute)] uppercase tracking-tight block mt-0.5">RANKED</span>
          </div>
          <div class="border-t sm:border-t-0 sm:border-l border-[var(--fc-hairline)] pt-2 sm:pt-0 sm:pl-3">
            <div class="flex items-baseline gap-1">
              <span class="font-display font-medium text-lg sm:text-xl text-[var(--fc-gold)] tracking-tight">#01</span>
              <span class="text-[10px] font-mono text-[#f7f5f0]">1,840 RP</span>
            </div>
            <span class="text-[10px] font-mono text-[var(--fc-mute)] uppercase tracking-tight block mt-0.5">LEADER · 94% WR</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Right Column: 3D Athlete Stage & Non-overlapping Perimeter HUD (5 cols desktop) -->
    <div id="hero-3d-hud" class="lg:col-span-5 relative h-full min-h-[460px] pointer-events-auto select-none transition-opacity duration-300">

      <!-- Mobile: Horizontal scroll row of HUD cards (strictly hidden on desktop) -->
      <div class="snap-row lg:hidden py-2">
        <!-- Card: Live Tournament -->
        <div class="min-w-[220px] p-3 rounded-[6px] bg-[var(--fc-canvas-soft)]/95 border border-[var(--fc-hairline)] shadow-lg pointer-events-auto">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[10px] font-mono">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] bg-[var(--fc-gold)]/10 text-[var(--fc-gold)] font-medium border border-[var(--fc-gold)]/25">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)] animate-pulse"></span>
                LIVE ROUND
              </span>
              <span class="text-[var(--fc-mute)]">128 PLAYERS</span>
            </div>
            <div>
              <h4 class="font-display font-medium text-xs text-[#f7f5f0] tracking-tight">FCForge Global Cup</h4>
              <p class="text-[10px] font-mono text-[var(--fc-body)]">eFootball™ Mobile Division I</p>
            </div>
            <div class="flex items-center justify-between pt-1.5 border-t border-[var(--fc-hairline)] text-[10px] font-mono">
              <span class="text-[var(--fc-mute)]">PRIZE POOL</span>
              <span class="font-medium text-[#f7f5f0]">$25,000 USD</span>
            </div>
          </div>
        </div>
        <!-- Card: Next Match -->
        <div class="min-w-[190px] p-3 rounded-[6px] bg-[var(--fc-canvas-soft)]/95 border border-[var(--fc-hairline)] shadow-lg pointer-events-auto">
          <div class="space-y-1">
            <div class="flex items-center justify-between text-[10px] font-mono">
              <span class="text-[var(--fc-gold)] font-medium">NEXT MATCH</span>
              <span class="px-1.5 py-0.5 rounded-[2px] bg-[var(--fc-canvas)] text-[var(--fc-body)] text-[9px] border border-[var(--fc-hairline)]">GRAND FINALS</span>
            </div>
            <div class="font-mono text-lg font-medium text-[#f7f5f0] tracking-wider">08:42</div>
            <p class="text-[10px] font-mono text-[var(--fc-mute)]">L. MESSI / #10 READY</p>
          </div>
        </div>
      </div>

      <!-- Desktop: Non-overlapping Perimeter HUD Overlays (hidden on mobile) -->
      <div class="hidden lg:block absolute inset-0 pointer-events-none">
        <!-- Interactive Drag Surface (No browser tooltip popup) -->
        <div
          id="hero-3d-interactive-zone"
          class="absolute inset-0 z-10 cursor-grab active:cursor-grabbing rounded-[8px] pointer-events-auto"
        ></div>

        <!-- Top-Right Corner HUD: Tournament Telemetry (Anchored away from model silhouette) -->
        <div
          class="floating-hero-card card-depth-1 absolute right-0 top-0 max-w-[200px] p-2.5 rounded-[6px] bg-[var(--fc-canvas-soft)]/90 backdrop-blur-md border border-[var(--fc-hairline)] shadow-xl transition-all duration-300 hover:border-[var(--fc-hairline-bright)] z-20 pointer-events-auto"
          style="transform: translate3d(0, 0, 20px);"
        >
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[10px] font-mono">
              <span class="inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded-[2px] bg-[var(--fc-gold)]/10 text-[var(--fc-gold)] font-medium border border-[var(--fc-gold)]/25">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)] animate-pulse"></span>
                LIVE ROUND
              </span>
              <span class="text-[var(--fc-mute)] text-[9px]">128 PLAYERS</span>
            </div>
            <div>
              <h4 class="font-display font-medium text-xs text-[#f7f5f0] tracking-tight">FCForge Global Cup</h4>
              <p class="text-[9px] font-mono text-[var(--fc-body)]">eFootball™ Mobile Div I</p>
            </div>
            <div class="flex items-center justify-between pt-1 border-t border-[var(--fc-hairline)] text-[9px] font-mono">
              <span class="text-[var(--fc-mute)]">PRIZE POOL</span>
              <span class="font-medium text-[var(--fc-gold)]">$25,000 USD</span>
            </div>
          </div>
        </div>

        <!-- Bottom-Right Corner HUD: Match Terminal & 360° Controls Dock -->
        <div class="absolute right-0 bottom-0 z-30 flex flex-col items-end gap-2 pointer-events-auto">
          <!-- Next Match Terminal Chip -->
          <div
            class="floating-hero-card card-depth-3 px-3 py-1.5 rounded-[4px] bg-[var(--fc-canvas-soft)]/95 backdrop-blur-md border border-[var(--fc-hairline)] shadow-xl flex items-center gap-3 font-mono text-[10px]"
            style="transform: translate3d(0, 0, 25px);"
          >
            <span class="text-[var(--fc-gold)] font-medium">NEXT MATCH</span>
            <span class="text-[#f7f5f0] font-medium tracking-wider text-xs">08:42</span>
            <span class="text-[var(--fc-mute)] text-[9px]">#10 READY</span>
          </div>

          <!-- 360° Interactive Athlete Controls & Rotation Hints (DESIGN.md) -->
          <div class="flex items-center gap-2 p-1.5 px-3 rounded-[4px] bg-[var(--fc-canvas-soft)]/95 backdrop-blur-md border border-[var(--fc-hairline)] font-mono text-[10px] shadow-2xl">
            <div class="flex items-center gap-2 pr-2 border-r border-[var(--fc-hairline)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)] animate-pulse"></span>
              <span id="hero-drag-hint-text" class="text-[#f7f5f0] font-medium tracking-tight">DRAG TO ROTATE 360°</span>
            </div>
            <div class="flex items-center gap-1">
              <button
                type="button"
                data-angle="0"
                class="hero-angle-preset-btn px-2 py-0.5 rounded-[2px] bg-[var(--fc-canvas)] hover:bg-[var(--fc-canvas-subtle)] border border-[var(--fc-hairline)] text-[var(--fc-primary)] transition-colors"
                title="Face front"
              >
                FRONT
              </button>
              <button
                type="button"
                data-angle="3.1415"
                class="hero-angle-preset-btn px-2 py-0.5 rounded-[2px] bg-[var(--fc-canvas)] hover:bg-[var(--fc-canvas-subtle)] border border-[var(--fc-hairline)] text-[var(--fc-gold)] transition-colors"
                title="View #10 Argentina Kit"
              >
                #10 BACK
              </button>
              <button
                type="button"
                data-angle="0"
                class="hero-angle-preset-btn px-1.5 py-0.5 rounded-[2px] bg-[var(--fc-canvas)] hover:bg-[var(--fc-canvas-subtle)] border border-[var(--fc-hairline)] text-[var(--fc-mute)] hover:text-[#f7f5f0] transition-colors"
                title="Reset to front angle"
              >
                ↺
              </button>
            </div>
          </div>
        </div>

      </div> <!-- /desktop perimeter HUD wrapper -->
    </div> <!-- /right column -->

  </div>

  <!-- Bottom Hero Footer & Scroll Prompt (DESIGN.md) -->
  <div class="max-w-7xl mx-auto w-full relative z-20 flex items-center justify-between text-[11px] font-mono text-[var(--fc-body)] border-t border-[var(--fc-hairline)] pt-3 pointer-events-auto">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
      <span class="text-[var(--fc-primary)] font-medium">MESSI #10 3D ARENA ACTIVE</span>
      <span class="hidden md:inline text-[var(--fc-mute)]">·</span>
      <span class="hidden md:inline text-[var(--fc-mute)]">THREE.JS REALTIME PBR ENGINE</span>
    </div>

    <a
      href="#chapter-reveal"
      class="group inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[var(--fc-canvas-soft)] hover:bg-[var(--fc-canvas-subtle)] border border-[var(--fc-hairline)] text-[var(--fc-primary)] transition-all duration-200"
      aria-label="Scroll to enter the arena"
    >
      <span>Scroll to enter arena</span>
      <span class="inline-block text-[var(--fc-gold)] font-mono text-xs group-hover:translate-y-0.5 transition-transform">↓</span>
    </a>
  </div>
</section>

<!-- Subtle CSS Keyframe Animations for Hero Stagger -->
<style>
  @keyframes fcHeroFadeUp {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-stagger-1 {
    animation: fcHeroFadeUp 0.6s cubic-bezier(0.32, 0.72, 0, 1) both;
    animation-delay: 0.05s;
  }
  .hero-stagger-2 {
    animation: fcHeroFadeUp 0.6s cubic-bezier(0.32, 0.72, 0, 1) both;
    animation-delay: 0.15s;
  }
  .hero-stagger-3 {
    animation: fcHeroFadeUp 0.6s cubic-bezier(0.32, 0.72, 0, 1) both;
    animation-delay: 0.25s;
  }
  .hero-stagger-4 {
    animation: fcHeroFadeUp 0.6s cubic-bezier(0.32, 0.72, 0, 1) both;
    animation-delay: 0.35s;
  }
  .hero-stagger-5 {
    animation: fcHeroFadeUp 0.6s cubic-bezier(0.32, 0.72, 0, 1) both;
    animation-delay: 0.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stagger-1,
    .hero-stagger-2,
    .hero-stagger-3,
    .hero-stagger-4,
    .hero-stagger-5 {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<!-- Mouse Parallax Script for Floating UI Cards -->
<script>
  const cards = document.querySelectorAll('.floating-hero-card');
  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!isReducedMotion && cards.length > 0 && window.innerWidth >= 768) {
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    window.addEventListener('mousemove', (e) => {
      targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetY = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });

    const updateFloatingCards = () => {
      currentX += (targetX - currentX) * 0.05;
      currentY += (targetY - currentY) * 0.05;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const depth = el.classList.contains('card-depth-1')
          ? 6
          : 4;

        const moveX = currentX * depth;
        const moveY = currentY * depth;
        el.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
      });

      requestAnimationFrame(updateFloatingCards);
    };

    updateFloatingCards();
  }

  // Smooth Scroll-Linked Fade for Hero 3D HUD (Leaves Chapter 2 100% Unobstructed)
  const heroHudContainer = document.getElementById('hero-3d-hud');
  if (heroHudContainer) {
    const handleHeroScroll = () => {
      const scrollY = window.scrollY;
      const opacity = Math.max(0, 1 - scrollY / 180);
      heroHudContainer.style.opacity = `${opacity}`;
      heroHudContainer.style.pointerEvents = opacity <= 0.05 ? 'none' : 'auto';
      heroHudContainer.style.transform = `translateY(-${Math.min(24, scrollY * 0.12)}px)`;
    };
    window.addEventListener('scroll', handleHeroScroll, { passive: true });
    handleHeroScroll();
  }

  // Preset Angle Buttons
  const presetButtons = document.querySelectorAll('.hero-angle-preset-btn');
  presetButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const el = btn as HTMLElement;
      const angle = parseFloat(el.dataset.angle || '0');
      window.dispatchEvent(new CustomEvent('fcforge:set-player-angle', { detail: { angle } }));
    });
  });

  // Dynamic Drag State Hint Update
  const hintText = document.getElementById('hero-drag-hint-text');
  window.addEventListener('fcforge:model-drag-state', ((e: CustomEvent) => {
    if (hintText) {
      if (e.detail?.isDragging) {
        hintText.textContent = 'ROTATING ATHLETE ...';
        hintText.classList.add('text-[var(--fc-gold)]');
      } else {
        hintText.textContent = 'DRAG TO ROTATE 360°';
        hintText.classList.remove('text-[var(--fc-gold)]');
      }
    }
  }) as EventListener);
</script>
