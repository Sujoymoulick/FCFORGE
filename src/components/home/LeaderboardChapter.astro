---
import { MOCK_LEADERBOARD } from '../../data/mock/leaderboard';
import UserAvatar from '../auth/UserAvatar.astro';
import UserProfileWidget from '../ui/UserProfileWidget.astro';
import LeagueTiers from './LeagueTiers.astro';
---

<section id="chapter-leaderboard" class="relative min-h-[90dvh] flex flex-col justify-center px-4 sm:px-8 py-20 sm:py-28 overflow-hidden">
  <div class="max-w-7xl mx-auto w-full relative z-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    
    <!-- Left Column: Global Rankings & Division Classification (cols 1-7) -->
    <div class="lg:col-span-7 space-y-8 text-left">
      <!-- Chapter Header (DESIGN.md) -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[var(--fc-hairline)] pb-6 reveal-up">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[4px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
            <span class="text-[11px] font-mono font-medium tracking-tight text-[var(--fc-primary)] uppercase">
              CHAPTER 06 // GLOBAL RANKING
            </span>
          </div>
          <h2 class="text-fluid-section font-display font-normal text-[#f7f5f0]">
            Global <span class="font-serif-italic text-[var(--fc-gold)] text-fluid-section-italic">rankings.</span>
          </h2>
        </div>

        <a href="/leaderboards" class="btn-warp-secondary text-xs py-1.5 px-3.5 self-start sm:self-auto group">
          <span>Explore ladder</span>
          <span class="font-mono text-xs group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      </div>

      <!-- Warp Data Table Container (ex-data-table-cell & card-mockup) -->
      <div class="rounded-[6px] border border-[var(--fc-hairline)] bg-[var(--fc-canvas-soft)] overflow-hidden shadow-xl">
        <!-- Broadcast Telemetry Header -->
        <div class="px-4 py-2.5 bg-[var(--fc-canvas)] border-b border-[var(--fc-hairline)] flex items-center justify-between text-xs font-mono">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
            <span class="text-[#f7f5f0] font-medium uppercase tracking-tight text-[11px]">SEASON 4 CIRCUIT // VERIFIED RATINGS</span>
          </div>
          <span class="text-[var(--fc-mute)] text-[10px] hidden sm:inline">REALTIME</span>
        </div>

        <!-- Table Column Headers -->
        <div class="grid grid-cols-12 gap-2 px-4 py-2 bg-[var(--fc-canvas-soft)] border-b border-[var(--fc-hairline)] font-mono text-[10px] text-[var(--fc-mute)] uppercase tracking-wider">
          <div class="col-span-2 sm:col-span-1 text-center">RANK</div>
          <div class="col-span-6 sm:col-span-6">ATHLETE</div>
          <div class="col-span-4 sm:col-span-2 text-right">ELO</div>
          <div class="hidden sm:block sm:col-span-3 text-right">WIN RATE</div>
        </div>

        <!-- Table Body Rows -->
        <div class="divide-y divide-[var(--fc-hairline)]">
          {MOCK_LEADERBOARD.slice(0, 5).map((entry, index) => {
            return (
              <div class={`grid grid-cols-12 gap-2 px-4 py-3 items-center transition-colors hover:bg-[var(--fc-canvas-subtle)] ${index === 0 ? 'bg-[var(--fc-gold)]/5' : ''}`}>
                <!-- Rank Position -->
                <div class="col-span-2 sm:col-span-1 flex items-center justify-center font-mono font-medium text-xs">
                  <span class={entry.rank === 1 ? 'text-[var(--fc-gold)] font-bold' : entry.rank <= 3 ? 'text-[#f7f5f0]' : 'text-[var(--fc-mute)]'}>
                    #{entry.rank.toString().padStart(2, '0')}
                  </span>
                </div>

                <!-- Player & Nationality -->
                <div class="col-span-6 sm:col-span-6 flex items-center gap-2.5 min-w-0">
                  <UserAvatar username={entry.username} avatarUrl={entry.avatarUrl} size="sm" />
                  <div class="truncate">
                    <div class="flex items-center gap-1.5">
                      <a href={`/profile/${entry.username}`} class="font-display font-medium text-xs sm:text-sm text-[#f7f5f0] hover:text-[var(--fc-gold)] transition-colors truncate">
                        {entry.username}
                      </a>
                      {entry.verified && (
                        <span class="text-[var(--fc-gold)] text-[10px]" title="Tournament Verified">✓</span>
                      )}
                    </div>
                    <span class="text-[10px] font-mono text-[var(--fc-mute)] block truncate">
                      {entry.region} · {entry.country}
                    </span>
                  </div>
                </div>

                <!-- ELO Rating -->
                <div class="col-span-4 sm:col-span-2 text-right font-mono">
                  <span class="font-medium text-xs sm:text-sm text-[#f7f5f0]">{entry.rating}</span>
                  <span class="text-[9px] text-[var(--fc-mute)] block">RP</span>
                </div>

                <!-- Win Rate -->
                <div class="hidden sm:block sm:col-span-3 text-right font-mono">
                  <span class="text-xs text-[#f7f5f0] font-medium">{entry.winRate}%</span>
                  <span class="text-[9px] text-[var(--fc-mute)] block">{entry.matchesPlayed} MATCHES</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- League Tier Divisions -->
      <LeagueTiers />
    </div>

    <!-- Right Column: Dedicated Blank Spot with Docked User Passport Widget (cols 8-12) -->
    <div class="lg:col-span-5 space-y-6">
      <!-- 3D athlete smoothly glides here into this open spatial zone -->
      <div class="hidden lg:block h-20 pointer-events-none"></div>

      <!-- Docked User Passport Widget -->
      <UserProfileWidget />
    </div>

  </div>
</section>
