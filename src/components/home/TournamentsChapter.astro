---
import { MOCK_TOURNAMENTS } from '../../data/mock/tournaments';
import UpcomingTicker from './UpcomingTicker.astro';

const statusBadgeColors: Record<string, string> = {
  'LIVE': 'bg-red-500/10 text-red-300 border-red-500/30',
  'REGISTRATION OPEN': 'bg-[var(--fc-gold)]/10 text-[var(--fc-gold)] border-[var(--fc-gold)]/30',
  'UPCOMING': 'bg-[var(--fc-canvas)] text-[var(--fc-primary)] border-[var(--fc-hairline)]',
  'COMPLETED': 'bg-[var(--fc-canvas)] text-[var(--fc-mute)] border-[var(--fc-hairline)]'
};
---

<section id="chapter-tournaments" class="relative min-h-[90dvh] flex flex-col justify-center px-4 sm:px-8 py-20 sm:py-28 overflow-hidden">
  <div class="max-w-7xl mx-auto w-full relative z-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    
    <!-- Left Column: Active Tournaments (cols 1-7) -->
    <div class="lg:col-span-7 space-y-8 text-left">
      <!-- Chapter Header (DESIGN.md) -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[var(--fc-hairline)] pb-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[4px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
            <span class="text-[11px] font-mono font-medium tracking-tight text-[var(--fc-primary)] uppercase">
              CHAPTER 04 // TOURNAMENT PORTAL
            </span>
          </div>
          <h2 class="font-display text-3xl sm:text-5xl font-normal tracking-[-0.03em] text-[#f7f5f0]">
            Active <span class="font-serif-italic text-[var(--fc-gold)] text-4xl sm:text-6xl">tournaments.</span>
          </h2>
        </div>

        <a href="/tournaments" class="btn-warp-secondary text-xs py-1.5 px-3.5 self-start sm:self-auto group">
          <span>Browse all ({MOCK_TOURNAMENTS.length})</span>
          <span class="font-mono text-xs group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      </div>

      <!-- Warp Cards Grid (card-content) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {MOCK_TOURNAMENTS.slice(0, 4).map(tournament => (
          <a
            href={`/tournaments/${tournament.slug}`}
            class="p-5 rounded-[6px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] hover:border-[var(--fc-hairline-bright)] flex flex-col justify-between group transition-all duration-200"
          >
            <div class="flex flex-col justify-between h-full space-y-4">
              <!-- Top Tag & Status (DM Mono) -->
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono font-medium text-[var(--fc-primary)] uppercase tracking-wider px-2 py-0.5 rounded-[3px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)]">
                  {tournament.gameTitle}
                </span>
                <span class={`text-[9px] font-mono font-medium px-2 py-0.5 rounded-[3px] border uppercase flex items-center gap-1.5 ${statusBadgeColors[tournament.status] || ''}`}>
                  {tournament.status === 'LIVE' && <span class="w-1 h-1 rounded-full bg-red-400"></span>}
                  {tournament.status}
                </span>
              </div>

              <!-- Tournament Title & Overview -->
              <div class="space-y-1.5">
                <h3 class="font-display font-medium text-base text-[#f7f5f0] group-hover:text-[var(--fc-gold)] transition-colors line-clamp-2 tracking-tight">
                  {tournament.title}
                </h3>
                <p class="text-xs text-[var(--fc-body)] line-clamp-2 leading-relaxed font-normal">
                  {tournament.description}
                </p>
              </div>

              <!-- Prize Pool & Slots Row (DM Mono) -->
              <div class="pt-3 border-t border-[var(--fc-hairline)] grid grid-cols-2 gap-3 font-mono text-[11px]">
                <div>
                  <span class="text-[var(--fc-mute)] text-[10px] block">PRIZE POOL</span>
                  <span class="text-[var(--fc-gold)] font-medium block">{tournament.prizePool}</span>
                </div>
                <div class="text-right">
                  <span class="text-[var(--fc-mute)] text-[10px] block">SLOTS</span>
                  <span class="text-[#f7f5f0] font-medium block">{tournament.currentParticipants} / {tournament.maxParticipants}</span>
                </div>
              </div>

              <!-- Footer Action -->
              <div class="flex items-center justify-between pt-2 text-xs font-mono text-[var(--fc-mute)] group-hover:text-[#f7f5f0] transition-colors">
                <span>{tournament.region}</span>
                <span class="text-[var(--fc-gold)] font-medium">ENTER BRACKET →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Right Column: Dedicated Blank Spot with Docked Schedule Ticker (cols 8-12) -->
    <div class="lg:col-span-5 space-y-6">
      <!-- 3D athlete smoothly glides here into this open spatial zone -->
      <div class="hidden lg:block h-28 pointer-events-none"></div>

      <!-- Docked Upcoming Schedule Widget -->
      <UpcomingTicker />
    </div>

  </div>
</section>
