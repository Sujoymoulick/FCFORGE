---
---

<section id="chapter-reveal" class="relative min-h-[90dvh] flex flex-col justify-center px-4 sm:px-8 py-20 sm:py-28 overflow-hidden">
  <div class="max-w-6xl mx-auto w-full relative z-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    
    <!-- Left Column: Spatial Character HUD Overlay (DESIGN.md) -->
    <div class="lg:col-span-7 space-y-6 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[4px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
        <span class="text-[11px] font-mono font-medium tracking-tight text-[var(--fc-primary)] uppercase">
          CHAPTER 02 // ATHLETE PROFILE
        </span>
      </div>

      <div class="space-y-3">
        <h2 class="font-display text-3xl sm:text-5xl font-normal tracking-[-0.03em] text-[#f7f5f0] leading-[1.05]">
          The pinnacle of <br />
          <span class="font-serif-italic text-[var(--fc-gold)] text-4xl sm:text-6xl">virtual athleticism.</span>
        </h2>
        <p class="text-sm text-[var(--fc-body)] max-w-lg leading-relaxed font-normal">
          Step onto the pitch with legendary precision. Every movement, touch, and tactical decision is calculated in real time against the global mobile meta.
        </p>
      </div>

      <!-- Warp Card: Player Passport Spec (card-content) -->
      <div class="p-4 sm:p-5 rounded-[6px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] max-w-lg space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--fc-hairline)] pb-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-[4px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)] flex items-center justify-center font-mono font-medium text-xs text-[var(--fc-gold)]">
              #10
            </div>
            <div>
              <span class="block text-xs font-medium text-[#f7f5f0] tracking-tight">L. MESSI — GOAT EDITION</span>
              <span class="text-[10px] font-mono text-[var(--fc-mute)] uppercase">STATUS: TOURNAMENT VERIFIED</span>
            </div>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-[3px] bg-[var(--fc-canvas)] text-[var(--fc-primary)] border border-[var(--fc-hairline)]">
            PRO ELO: 2450
          </span>
        </div>

        <!-- Stat Progress Bars (DM Mono Numbers) -->
        <div class="space-y-2.5 font-mono text-xs">
          <div>
            <div class="flex justify-between mb-1 text-[11px]">
              <span class="text-[var(--fc-body)]">ACCELERATION & AGILITY</span>
              <span class="text-[var(--fc-primary)] font-medium">99 / 100</span>
            </div>
            <div class="w-full bg-[var(--fc-canvas)] h-1 rounded-[1px] overflow-hidden border border-[var(--fc-hairline)]">
              <div class="bg-[var(--fc-gold)] h-full w-[99%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1 text-[11px]">
              <span class="text-[var(--fc-body)]">BALL CONTROL & FINISHING</span>
              <span class="text-[var(--fc-primary)] font-medium">99 / 100</span>
            </div>
            <div class="w-full bg-[var(--fc-canvas)] h-1 rounded-[1px] overflow-hidden border border-[var(--fc-hairline)]">
              <div class="bg-[var(--fc-primary)] h-full w-[99%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1 text-[11px]">
              <span class="text-[var(--fc-body)]">TACTICAL CLUTCH IQ</span>
              <span class="text-[var(--fc-primary)] font-medium">97 / 100</span>
            </div>
            <div class="w-full bg-[var(--fc-canvas)] h-1 rounded-[1px] overflow-hidden border border-[var(--fc-hairline)]">
              <div class="bg-[var(--fc-gold)] h-full w-[97%]"></div>
            </div>
          </div>
        </div>
      </div>
      <!-- 3D Arena Asset Hardware Telemetry (DESIGN.md card-mockup) -->
      <div class="p-3 sm:p-4 rounded-[6px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] max-w-lg space-y-2.5">
        <div class="flex items-center justify-between text-[11px] font-mono border-b border-[var(--fc-hairline)] pb-2">
          <span class="text-[var(--fc-gold)] font-medium">3D ARENA ASSET</span>
          <span class="text-[var(--fc-mute)] text-[10px]">HARDWARE ACCELERATED</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[10px] font-mono">
          <div>
            <span class="text-[var(--fc-mute)] block text-[9px] uppercase">MODEL</span>
            <span class="text-[var(--fc-primary)] font-medium">messimodel.glb</span>
          </div>
          <div>
            <span class="text-[var(--fc-mute)] block text-[9px] uppercase">VERTICES</span>
            <span class="text-[var(--fc-primary)] font-medium">402K PBR</span>
          </div>
          <div>
            <span class="text-[var(--fc-mute)] block text-[9px] uppercase">TEXTURE</span>
            <span class="text-[var(--fc-primary)] font-medium">2048px 3-Pass</span>
          </div>
          <div>
            <span class="text-[var(--fc-mute)] block text-[9px] uppercase">LIGHTING</span>
            <span class="text-[var(--fc-gold)] font-medium">Dual Rim</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Dedicated Open Blank Spot for Close-up 3D Athlete (cols 8-12) -->
    <div class="hidden lg:block lg:col-span-5 pointer-events-none min-h-[480px]">
      <!-- 100% Unobstructed spatial zone where Lionel Messi is showcased in 3D close-up -->
    </div>

  </div>
</section>
