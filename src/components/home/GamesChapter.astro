---
import { MOCK_GAMES } from '../../data/mock/games';
---

<section id="chapter-games" class="relative min-h-[90dvh] flex flex-col justify-center px-4 sm:px-8 py-20 sm:py-28 overflow-hidden">
  <div class="max-w-7xl mx-auto w-full relative z-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    
    <!-- Left Column: Open Blank Spot for 3D Athlete (cols 1-5) -->
    <div class="hidden lg:block lg:col-span-5 pointer-events-none">
      <!-- High-performance open spatial zone where 3D athlete smoothly glides -->
    </div>

    <!-- Right Column: Choose Your Battle (cols 6-12) -->
    <div class="lg:col-span-7 space-y-8 text-left">
      <div class="space-y-3 reveal-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[4px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
          <span class="text-[11px] font-mono font-medium tracking-tight text-[var(--fc-primary)] uppercase">
            CHAPTER 03 // GAME SELECTION
          </span>
        </div>
        <h2 class="text-fluid-section font-display font-normal text-[#f7f5f0]">
          Choose your <span class="font-serif-italic text-[var(--fc-gold)] text-fluid-section-italic">battle.</span>
        </h2>
        <p class="text-sm text-[var(--fc-body)] font-normal max-w-xl leading-relaxed">
          Select your arena. FCForge powers dedicated competitive ladders and official bracket tournaments for the world's leading mobile football simulations.
        </p>
      </div>

      <!-- Cards: snap-row on mobile, grid on sm+ -->
      <div class="snap-row sm:grid sm:grid-cols-2 sm:gap-5">
        {MOCK_GAMES.map((game, idx) => (
          <div
            class="reveal-up game-tilt-card min-w-[280px] sm:min-w-0 p-5 sm:p-6 rounded-[6px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] hover:border-[var(--fc-hairline-bright)] flex flex-col justify-between h-full space-y-5 transition-all duration-300 group"
            data-index={idx}
          >
            <!-- Top Publisher Badge & Live Count (DM Mono) -->
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-medium tracking-wider px-2.5 py-0.5 rounded-[3px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)] text-[var(--fc-primary)]">
                {game.publisher}
              </span>
              <span class="text-[10px] font-mono font-medium px-2.5 py-0.5 rounded-[3px] bg-[var(--fc-canvas)] text-[var(--fc-gold)] border border-[var(--fc-hairline)] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
                {game.activeTournamentsCount} LIVE
              </span>
            </div>

            <!-- Game Title & Description -->
            <div class="space-y-1.5">
              <h3 class="font-display font-medium text-xl sm:text-2xl text-[#f7f5f0] tracking-tight group-hover:text-[var(--fc-gold)] transition-colors">
                {game.name}
              </h3>
              <p class="text-xs text-[var(--fc-body)] leading-relaxed font-normal">
                {game.description}
              </p>
            </div>

            <!-- Features Tags (DM Mono) -->
            <div class="flex flex-wrap gap-1.5 text-[10px] font-mono">
              <span class="px-2 py-0.5 rounded-[3px] bg-[var(--fc-canvas)] text-[var(--fc-body)] border border-[var(--fc-hairline)]">RANKED</span>
              <span class="px-2 py-0.5 rounded-[3px] bg-[var(--fc-canvas)] text-[var(--fc-body)] border border-[var(--fc-hairline)]">CASH POOLS</span>
              <span class="px-2 py-0.5 rounded-[3px] bg-[var(--fc-canvas)] text-[var(--fc-gold)] border border-[var(--fc-hairline)]">FINALS</span>
            </div>

            <!-- Action Footer (DESIGN.md button-primary & text-sm) -->
            <div class="pt-3 border-t border-[var(--fc-hairline)] flex items-center justify-between mt-auto">
              <span class="text-xs font-mono uppercase text-[var(--fc-body)] font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-primary)]"></span>
                {game.platform}
              </span>
              <a href={`/tournaments?game=${game.id}`} class="btn-warp-primary text-xs py-1.5 px-3">
                <span>Enter arena</span>
                <span class="font-mono text-xs">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Subtle card hover tilt
  const cards = document.querySelectorAll('.game-tilt-card');
  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!isReducedMotion && window.innerWidth >= 768) {
    cards.forEach(card => {
      card.addEventListener('mousemove', (e: any) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = (y - centerY) / -30;
        const rotateY = (x - centerX) / 30;

        (card as HTMLElement).style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-2px)`;
      });

      card.addEventListener('mouseleave', () => {
        (card as HTMLElement).style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
      });
    });
  }
</script>
