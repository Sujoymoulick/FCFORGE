---
import { getAuthUser } from '../../lib/auth';
import UserAvatar from '../auth/UserAvatar.astro';

const user = getAuthUser();
---

<div class="p-4 rounded-[6px] bg-[var(--fc-canvas-soft)] border border-[var(--fc-hairline)] space-y-4">
  <!-- User Profile Header (DESIGN.md) -->
  <div class="flex items-center gap-3 border-b border-[var(--fc-hairline)] pb-3">
    <UserAvatar src={user?.avatar} name={user?.username} size="md" />
    <div class="flex flex-col min-w-0">
      <span class="font-display font-medium text-xs sm:text-sm text-[#f7f5f0] truncate">{user?.username || 'Kagami_FC'}</span>
      <span class="text-[10px] font-mono text-[var(--fc-gold)] uppercase">PRO ELO: {user?.rating || 2450}</span>
    </div>
  </div>

  <!-- Quick Stats Grid (DM Mono Tabular Figures) -->
  <div class="grid grid-cols-2 gap-2 text-center text-xs font-mono">
    <div class="p-2 rounded-[3px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)]">
      <span class="text-[9px] text-[var(--fc-mute)] block uppercase">GLOBAL RANK</span>
      <span class="font-medium text-[#f7f5f0] text-sm block mt-0.5">#{user?.rank || '01'}</span>
    </div>
    <div class="p-2 rounded-[3px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)]">
      <span class="text-[9px] text-[var(--fc-mute)] block uppercase">WIN RATE</span>
      <span class="font-medium text-[var(--fc-gold)] text-sm block mt-0.5">88.5%</span>
    </div>
  </div>

  <!-- Action Link (DESIGN.md button-secondary-ghost) -->
  <a href="/dashboard" class="btn-warp-secondary w-full text-xs py-1.5 px-3 justify-center text-center block">
    <span>Open player passport →</span>
  </a>
</div>
