---
---

<footer class="bg-[var(--fc-canvas)] border-t border-[var(--fc-hairline)] py-12 px-4 sm:px-8 relative overflow-hidden text-sm text-[var(--fc-body)]">
  <div class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
    <!-- Brand Info -->
    <div class="md:col-span-1 space-y-3">
      <div class="flex items-center gap-2.5">
        <div class="w-6 h-6 rounded-[3px] bg-[#f7f5f0] flex items-center justify-center font-display font-black text-xs text-[#161311]">
          FC
        </div>
        <span class="font-display font-medium text-base tracking-tight text-[#f7f5f0]">FCForge</span>
      </div>
      <p class="text-xs text-[var(--fc-body)] leading-relaxed">
        The premier competitive football platform for eFootball™ Mobile and EA SPORTS FC™ Mobile athletes. Verify ratings, enter tournament brackets, and compete on the global ladder.
      </p>
      <div class="text-[11px] font-mono text-[var(--fc-mute)]">
        https://fcforge.com
      </div>
    </div>

    <!-- Quick Navigation (DESIGN.md) -->
    <div class="space-y-3">
      <h4 class="font-mono text-xs text-[var(--fc-primary)] uppercase tracking-wider">ESPORTS ARENA</h4>
      <ul class="space-y-2 text-xs">
        <li><a href="/tournaments" class="hover:text-[#f7f5f0] transition-colors">Tournaments Directory</a></li>
        <li><a href="/tournaments?status=LIVE" class="hover:text-[var(--fc-gold)] transition-colors flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span> Live Brackets</a></li>
        <li><a href="/leaderboards" class="hover:text-[#f7f5f0] transition-colors">Global Leaderboard</a></li>
        <li><a href="/dashboard" class="hover:text-[#f7f5f0] transition-colors">Player Passport Dashboard</a></li>
      </ul>
    </div>

    <!-- Supported Platforms -->
    <div class="space-y-3">
      <h4 class="font-mono text-xs text-[var(--fc-primary)] uppercase tracking-wider">COMPETITIVE PLATFORMS</h4>
      <ul class="space-y-2 text-xs text-[var(--fc-body)]">
        <li><span class="text-[#f7f5f0] font-medium">eFootball™ Mobile</span> (Konami)</li>
        <li><span class="text-[#f7f5f0] font-medium">EA SPORTS FC™ Mobile</span> (EA Sports)</li>
        <li><span class="text-[var(--fc-mute)]">Hardware Verified Matchmaking Engine</span></li>
      </ul>
    </div>

    <!-- Community & Regulation -->
    <div class="space-y-3">
      <h4 class="font-mono text-xs text-[var(--fc-primary)] uppercase tracking-wider">REGULATION</h4>
      <ul class="space-y-2 text-xs">
        <li><a href="/tournaments" class="hover:text-[#f7f5f0] transition-colors">Fair Play Policy</a></li>
        <li><a href="/tournaments" class="hover:text-[#f7f5f0] transition-colors">Tournament Rules & Guidelines</a></li>
        <li><a href="/tournaments" class="hover:text-[#f7f5f0] transition-colors">Terms of Service</a></li>
        <li><a href="/tournaments" class="hover:text-[#f7f5f0] transition-colors">Privacy Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto border-t border-[var(--fc-hairline)] pt-5 flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--fc-mute)] gap-3 font-mono">
    <div>
      © 2026 FCFORGE. All rights reserved. Competitive esports platform.
    </div>
    <div class="flex items-center gap-4 text-[11px]">
      <span class="text-[var(--fc-gold)] flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
        WARP TELEMETRY ONLINE
      </span>
      <span>LATENCY: 12ms</span>
    </div>
  </div>
</footer>
