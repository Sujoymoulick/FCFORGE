---
interface Props {
  src?: string;
  name?: string;
  size?: 'sm' | 'md' | 'lg';
  rank?: number;
}

const { src, name = 'Player', size = 'md', rank } = Astro.props;

const sizeClasses = {
  sm: 'w-7 h-7 text-xs',
  md: 'w-9 h-9 text-sm',
  lg: 'w-12 h-12 text-base'
};
---

<div class="relative inline-block">
  <div class={`rounded-full overflow-hidden border border-[var(--fc-cyan)]/40 bg-[var(--fc-surface-2)] flex items-center justify-center font-bold text-[var(--fc-cyan)] shadow-sm ${sizeClasses[size]}`}>
    {src ? (
      <img src={src} alt={name} class="w-full h-full object-cover" />
    ) : (
      <span>{name.charAt(0).toUpperCase()}</span>
    )}
  </div>
  {rank && (
    <span class="absolute -bottom-1 -right-1 bg-[var(--fc-cyan)] text-[#05070A] font-extrabold text-[10px] px-1 rounded-full border border-[#05070A] min-w-[16px] text-center">
      #{rank}
    </span>
  )}
</div>
