---
import Layout from '../../layouts/Layout.astro';
import { MOCK_TOURNAMENTS, type Tournament } from '../../data/mock/tournaments';

export function getStaticPaths() {
  return MOCK_TOURNAMENTS.map(tournament => ({
    params: { slug: tournament.slug },
    props: { tournament }
  }));
}

interface Props {
  tournament: Tournament;
}

const { tournament } = Astro.props;
---

<Layout title={`${tournament.title} — FCForge Tournament`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-10 space-y-8">
    <!-- Header Banner & Telemetry (DESIGN.md) -->
    <div class="rounded-[6px] border border-[var(--fc-hairline)] bg-[var(--fc-canvas-soft)] overflow-hidden">
      <!-- Tournament Banner -->
      <div class="h-44 sm:h-64 w-full relative overflow-hidden bg-[var(--fc-canvas)]">
        <img src={tournament.bannerImage} alt={tournament.title} class="w-full h-full object-cover opacity-45" />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--fc-canvas-soft)] via-[var(--fc-canvas-soft)]/50 to-transparent"></div>
        <div class="absolute top-4 left-4 sm:left-8">
          <a href="/tournaments" class="text-xs font-mono text-[var(--fc-mute)] hover:text-[#f7f5f0] transition-colors flex items-center gap-1.5 px-3 py-1.5 rounded-[3px] bg-[var(--fc-canvas)]/80 backdrop-blur-md border border-[var(--fc-hairline)]">
            <span>←</span> Back to tournaments
          </a>
        </div>
        <div class="absolute top-4 right-4 sm:right-8 flex items-center gap-2">
          <span class="text-[10px] font-mono font-medium px-2.5 py-1 rounded-[3px] bg-[var(--fc-canvas)]/90 backdrop-blur-md border border-[var(--fc-hairline)] text-[var(--fc-primary)]">
            {tournament.gameTitle}
          </span>
          <span class={`text-[10px] font-mono font-medium px-2.5 py-1 rounded-[3px] backdrop-blur-md border ${
            tournament.status === 'LIVE' ? 'bg-[#ff5555]/20 text-[#ff7777] border-[#ff5555]/30' :
            tournament.status === 'REGISTRATION OPEN' ? 'bg-[var(--fc-primary)]/20 text-[var(--fc-primary)] border-[var(--fc-primary)]/30' :
            'bg-[var(--fc-canvas)]/90 text-[var(--fc-mute)] border-[var(--fc-hairline)]'
          }`}>
            {tournament.status}
          </span>
        </div>
      </div>

      <!-- Header Body -->
      <div class="p-6 sm:p-8 space-y-6">
        <div class="space-y-3 max-w-3xl">
          <h1 class="font-display font-normal text-3xl sm:text-4xl lg:text-5xl text-[#f7f5f0] tracking-[-0.035em] leading-tight">
            {tournament.title}
          </h1>
          <p class="text-sm text-[var(--fc-body)] leading-relaxed">
            {tournament.description}
          </p>
        </div>

        <!-- Quick Stats Bar (DM Mono) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-[4px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)] text-center text-xs font-mono">
          <div>
            <span class="block text-[10px] text-[var(--fc-mute)] uppercase">TOTAL PRIZE POOL</span>
            <span class="font-medium text-lg text-[var(--fc-gold)] block mt-0.5">{tournament.prizePool}</span>
          </div>
          <div class="border-l border-[var(--fc-hairline)]">
            <span class="block text-[10px] text-[var(--fc-mute)] uppercase">PARTICIPANTS</span>
            <span class="font-medium text-lg text-[#f7f5f0] block mt-0.5">{tournament.currentParticipants} / {tournament.maxParticipants}</span>
          </div>
          <div class="border-l border-[var(--fc-hairline)]">
            <span class="block text-[10px] text-[var(--fc-mute)] uppercase">REGION</span>
            <span class="font-medium text-lg text-[#f7f5f0] block mt-0.5">{tournament.region}</span>
          </div>
          <div class="border-l border-[var(--fc-hairline)]">
            <span class="block text-[10px] text-[var(--fc-mute)] uppercase">FORMAT</span>
            <span class="font-medium text-lg text-[#f7f5f0] block mt-0.5">{tournament.format}</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {tournament.status === 'REGISTRATION OPEN' ? (
            <button class="btn-warp-primary text-xs py-2 px-5">
              <span>Register your roster</span>
              <span class="font-mono text-xs">→</span>
            </button>
          ) : (
            <button class="btn-warp-secondary text-xs py-2 px-4 cursor-default opacity-85">
              <span>Tournament in progress</span>
            </button>
          )}
          <a href="#bracket" class="btn-warp-secondary text-xs py-2 px-4">
            <span>View bracket tree</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left 2 Cols: Bracket & Schedule -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Interactive Bracket Tree -->
        <div id="bracket" class="rounded-[6px] border border-[var(--fc-hairline)] bg-[var(--fc-canvas-soft)] p-5 sm:p-6 space-y-5">
          <div class="flex items-center justify-between border-b border-[var(--fc-hairline)] pb-3">
            <div>
              <h2 class="font-display font-medium text-base text-[#f7f5f0] tracking-tight">Tournament Bracket Engine</h2>
              <span class="text-xs text-[var(--fc-mute)] font-mono">Live match state & verified scores</span>
            </div>
            <span class="text-xs font-mono text-[var(--fc-gold)]">{tournament.status}</span>
          </div>

          {tournament.matchBracket && (tournament.matchBracket.quarterFinals?.length || tournament.matchBracket.semiFinals?.length || tournament.matchBracket.finals?.length) ? (
            <div class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Quarterfinals -->
                {tournament.matchBracket.quarterFinals && tournament.matchBracket.quarterFinals.length > 0 && (
                  <div class="space-y-3">
                    <span class="block text-[10px] font-mono text-[var(--fc-mute)] uppercase border-b border-[var(--fc-hairline)] pb-1">
                      QUARTERFINALS
                    </span>
                    {tournament.matchBracket.quarterFinals.map((match) => (
                      <div class="p-3 rounded-[4px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)] space-y-1.5 font-mono text-xs">
                        <div class="flex items-center justify-between">
                          <span class={match.winner === match.p1 ? 'text-[#f7f5f0] font-medium' : 'text-[var(--fc-body)]'}>
                            {match.p1}
                          </span>
                          <span class="font-medium text-[#f7f5f0]">{match.s1}</span>
                        </div>
                        <div class="flex items-center justify-between border-t border-[var(--fc-hairline)] pt-1">
                          <span class={match.winner === match.p2 ? 'text-[#f7f5f0] font-medium' : 'text-[var(--fc-body)]'}>
                            {match.p2}
                          </span>
                          <span class="font-medium text-[#f7f5f0]">{match.s2}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                <!-- Semifinals -->
                {tournament.matchBracket.semiFinals && tournament.matchBracket.semiFinals.length > 0 && (
                  <div class="space-y-3">
                    <span class="block text-[10px] font-mono text-[var(--fc-gold)] uppercase border-b border-[var(--fc-hairline)] pb-1 flex items-center justify-between">
                      <span>SEMIFINALS</span>
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-gold)]"></span>
                    </span>
                    {tournament.matchBracket.semiFinals.map((match) => (
                      <div class="p-3 rounded-[4px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)] space-y-1.5 font-mono text-xs">
                        <div class="flex items-center justify-between">
                          <span class={match.winner === match.p1 ? 'text-[#f7f5f0] font-medium' : 'text-[var(--fc-body)]'}>
                            {match.p1}
                          </span>
                          <span class="font-medium text-[var(--fc-gold)]">{match.s1}</span>
                        </div>
                        <div class="flex items-center justify-between border-t border-[var(--fc-hairline)] pt-1">
                          <span class={match.winner === match.p2 ? 'text-[#f7f5f0] font-medium' : 'text-[var(--fc-body)]'}>
                            {match.p2}
                          </span>
                          <span class="font-medium text-[#f7f5f0]">{match.s2}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                <!-- Finals -->
                {tournament.matchBracket.finals && tournament.matchBracket.finals.length > 0 && (
                  <div class="space-y-3">
                    <span class="block text-[10px] font-mono text-[var(--fc-primary)] uppercase border-b border-[var(--fc-hairline)] pb-1 flex items-center justify-between">
                      <span>GRAND FINALS</span>
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--fc-primary)]"></span>
                    </span>
                    {tournament.matchBracket.finals.map((match) => (
                      <div class="p-3 rounded-[4px] bg-[var(--fc-canvas)] border border-[var(--fc-gold)]/40 shadow-lg space-y-1.5 font-mono text-xs">
                        <div class="flex items-center justify-between">
                          <span class={match.winner === match.p1 ? 'text-[var(--fc-gold)] font-bold' : 'text-[var(--fc-body)]'}>
                            {match.p1} {match.winner === match.p1 ? '🏆' : ''}
                          </span>
                          <span class="font-bold text-[var(--fc-gold)]">{match.s1}</span>
                        </div>
                        <div class="flex items-center justify-between border-t border-[var(--fc-hairline)] pt-1">
                          <span class={match.winner === match.p2 ? 'text-[var(--fc-gold)] font-bold' : 'text-[var(--fc-body)]'}>
                            {match.p2} {match.winner === match.p2 ? '🏆' : ''}
                          </span>
                          <span class="font-bold text-[#f7f5f0]">{match.s2}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div class="p-10 text-center text-xs font-mono text-[var(--fc-mute)] bg-[var(--fc-canvas)] rounded-[4px] border border-[var(--fc-hairline)] space-y-2">
              <span class="text-xl block">📋</span>
              <p class="text-[#f7f5f0] font-medium">Tournament bracket will generate upon registration close</p>
              <p class="text-[11px] text-[var(--fc-mute)]">Participants are seeded by their global FCForge ELO rating.</p>
            </div>
          )}
        </div>

        <!-- Schedule Roadmap -->
        {tournament.schedule && tournament.schedule.length > 0 && (
          <div class="rounded-[6px] border border-[var(--fc-hairline)] bg-[var(--fc-canvas-soft)] p-5 sm:p-6 space-y-4">
            <h3 class="font-display font-medium text-sm text-[#f7f5f0] border-b border-[var(--fc-hairline)] pb-2 tracking-tight">
              Event Schedule & Broadcast Timeline
            </h3>
            <div class="space-y-2 font-mono text-xs">
              {tournament.schedule.map((item) => (
                <div class="p-3 rounded-[4px] bg-[var(--fc-canvas)] border border-[var(--fc-hairline)] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class={`w-2 h-2 rounded-full ${
                      item.status === 'Live' ? 'bg-[#ff5555] animate-pulse' :
                      item.status === 'Completed' ? 'bg-[var(--fc-primary)]' :
                      'bg-[var(--fc-mute)]'
                    }`}></span>
                    <span class="text-[#f7f5f0] font-medium">{item.stage}</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="text-[var(--fc-body)] text-[11px]">{item.time}</span>
                    <span class={`text-[9px] uppercase px-1.5 py-0.5 rounded-[2px] border ${
                      item.status === 'Live' ? 'text-[#ff7777] border-[#ff5555]/30 bg-[#ff5555]/10' :
                      item.status === 'Completed' ? 'text-[var(--fc-primary)] border-[var(--fc-primary)]/30 bg-[var(--fc-primary)]/10' :
                      'text-[var(--fc-mute)] border-[var(--fc-hairline)] bg-[var(--fc-canvas-soft)]'
                    }`}>
                      {item.status}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Col: Rules & Prizing Sidebar -->
      <div class="space-y-6">
        <!-- Prize Breakdown -->
        <div class="rounded-[6px] border border-[var(--fc-hairline)] bg-[var(--fc-canvas-soft)] p-5 space-y-3">
          <h3 class="font-display font-medium text-sm text-[#f7f5f0] border-b border-[var(--fc-hairline)] pb-2 tracking-tight">
            Prize Distribution
          </h3>
          <div class="space-y-2 font-mono text-xs">
            <div class="flex justify-between py-1 border-b border-[var(--fc-hairline)]">
              <span class="text-[var(--fc-gold)] font-medium">1st Place (Champion)</span>
              <span class="text-[#f7f5f0] font-medium">60%</span>
            </div>
            <div class="flex justify-between py-1 border-b border-[var(--fc-hairline)]">
              <span class="text-[#f7f5f0]">2nd Place (Runner-up)</span>
              <span class="text-[var(--fc-body)]">25%</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-[var(--fc-mute)]">3rd - 4th Place</span>
              <span class="text-[var(--fc-body)]">15%</span>
            </div>
          </div>
        </div>

        <!-- Rules & Requirements from mock -->
        <div class="rounded-[6px] border border-[var(--fc-hairline)] bg-[var(--fc-canvas-soft)] p-5 space-y-3 text-xs">
          <h3 class="font-display font-medium text-sm text-[#f7f5f0] border-b border-[var(--fc-hairline)] pb-2 tracking-tight">
            Official Tournament Rules
          </h3>
          <ul class="space-y-2 text-[var(--fc-body)] leading-relaxed font-sans">
            {tournament.rules && tournament.rules.length > 0 ? (
              tournament.rules.map((rule, idx) => (
                <li class="flex items-start gap-2">
                  <span class="text-[var(--fc-gold)] font-mono shrink-0">{idx + 1}.</span>
                  <span>{rule}</span>
                </li>
              ))
            ) : (
              <li class="flex items-start gap-2">
                <span class="text-[var(--fc-gold)] font-mono">1.</span>
                <span>Standard FCForge fair play competitive guidelines apply.</span>
              </li>
            )}
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>
