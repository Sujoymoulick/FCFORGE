---
import Layout from '../layouts/Layout.astro';
import FCForgePlayer3D from '../components/3d/FCForgePlayer3D.astro';
import HeroChapter from '../components/hero/HeroChapter.astro';
import CharacterRevealChapter from '../components/home/CharacterRevealChapter.astro';
import GamesChapter from '../components/home/GamesChapter.astro';
import TournamentsChapter from '../components/home/TournamentsChapter.astro';
import LeagueTiers from '../components/home/LeagueTiers.astro';
import BracketChapter from '../components/home/BracketChapter.astro';
import LeaderboardChapter from '../components/home/LeaderboardChapter.astro';
import EsportsNews from '../components/home/EsportsNews.astro';
import ChampionshipChapter from '../components/home/ChampionshipChapter.astro';
import ChapterHUD from '../components/ui/ChapterHUD.astro';
import UserProfileWidget from '../components/ui/UserProfileWidget.astro';
import UpcomingTicker from '../components/home/UpcomingTicker.astro';
---

<Layout title="FCForge — Global Football Esports Arena | Interactive 3D Portal">
  <!-- Interactive Storyline Side Chapter HUD -->
  <ChapterHUD />

  <!-- Fixed 3D Three.js Stadium & Character Engine Canvas -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <!-- Stadium Floor Grid -->
    <div class="absolute inset-0 stadium-grid opacity-25"></div>
    
    <!-- Dynamic Ambient Lighting Glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[900px] h-[900px] bg-gradient-radial from-[var(--fc-cyan)]/15 via-transparent to-transparent rounded-full blur-3xl pointer-events-none"></div>

    <!-- Flagship 3D Football Player Centerpiece Experience (Modular GLB asset path) -->
    <FCForgePlayer3D
      model="/messimodel.glb"
      position={[0, 0, 0]}
      scale={[1, 1, 1]}
      className="w-full h-full"
    />
  </div>

  <!-- Main Esports Portal Content Shell -->
  <div class="relative z-10 space-y-16">
    <!-- CHAPTER 01 — ARENA ARRIVAL -->
    <HeroChapter />

    <!-- CHAPTER 02 — CHARACTER REVEAL -->
    <CharacterRevealChapter />

    <!-- CHAPTER 03 TO 06 — MAIN ESPORTS PORTAL & FEED GRID -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Main Stream Feed (8 Cols) -->
        <main class="lg:col-span-8 space-y-16">
          <!-- CHAPTER 03 — GAME SELECTION -->
          <GamesChapter />

          <!-- CHAPTER 04 — TOURNAMENT PORTAL -->
          <TournamentsChapter />

          <!-- COMPETITIVE LEAGUE TIERS (Amateur, Premier, Legends Division Crests) -->
          <LeagueTiers />

          <!-- CHAPTER 05 — COMPETITION ENGINE (Holographic Match Bracket) -->
          <BracketChapter />

          <!-- CHAPTER 06 — GLOBAL RANKINGS -->
          <LeaderboardChapter />

          <!-- ESPORTS NEWS & BROADCASTS -->
          <EsportsNews />
        </main>

        <!-- Right Esports Dashboard Sidebar (4 Cols - Inspired by Reference UI) -->
        <aside class="lg:col-span-4 space-y-8 sticky top-24">
          <!-- User Profile Passport -->
          <UserProfileWidget />

          <!-- Upcoming Events Ticker & Schedule -->
          <UpcomingTicker />
        </aside>

      </div>
    </div>

    <!-- CHAPTER 07 — CHAMPIONSHIP FINALE -->
    <ChampionshipChapter />
  </div>
</Layout>
